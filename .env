# EOS Tracker Environment Configuration
# This is your .env file - update with your actual values

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@db:5432/eos_tracker

# Docker Python Path (Required for module imports)
PYTHONPATH=/app

# JWT Authentication
# CRITICAL: Change this to a secure random string in production!
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=dev-secret-key-change-in-production-use-random-string
JWT_ALGORITHM=HS256

# Email Service (Future - Module 6)
# AWS_SES_ACCESS_KEY=your-aws-access-key
# AWS_SES_SECRET_KEY=your-aws-secret-key
# AWS_SES_REGION=us-east-1
# EMAIL_FROM=noreply@eostrack.com

# Payment Processing (Future - Module 5)
# PAYSTACK_SECRET_KEY=sk_test_xxxxx
# PAYSTACK_PUBLIC_KEY=pk_test_xxxxx

# Application Settings
APP_NAME=EOS Tracker
DEBUG=True
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
