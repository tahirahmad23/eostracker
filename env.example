# ==============================================================================
# EOS TRACKER - ENVIRONMENT VARIABLES
# ==============================================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control!

# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================

# Development (SQLite)
DATABASE_URL=sqlite:///./eos_tracker.db

# Production (PostgreSQL) - Use one of these formats:
# DATABASE_URL=postgresql://username:password@localhost:5432/eos_tracker
# DATABASE_URL=postgresql://username:password@host.com:5432/eos_tracker
# DATABASE_URL=${DATABASE_URL}  # For managed database services


# ==============================================================================
# JWT AUTHENTICATION
# ==============================================================================

# Secret key for JWT tokens (CHANGE THIS! Minimum 32 characters)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars

# JWT algorithm (do not change unless you know what you're doing)
JWT_ALGORITHM=HS256

# Access token expiration in minutes
JWT_EXPIRATION_MINUTES=30

# Refresh token expiration in days
JWT_REFRESH_EXPIRATION_DAYS=7


# ==============================================================================
# SESSION MANAGEMENT
# ==============================================================================

# Session secret key for flash messages (CHANGE THIS! Minimum 32 characters)
SESSION_SECRET_KEY=your-super-secret-session-key-change-this-in-production-min-32-chars


# ==============================================================================
# PAYSTACK PAYMENT PROCESSING
# ==============================================================================

# Test Mode Keys (for development)
PAYSTACK_SECRET_KEY=sk_test_your_test_secret_key_here
PAYSTACK_PUBLIC_KEY=pk_test_your_test_public_key_here

# Production Keys (uncomment when going live)
# PAYSTACK_SECRET_KEY=sk_live_your_live_secret_key_here
# PAYSTACK_PUBLIC_KEY=pk_live_your_live_public_key_here

# Paystack webhook secret (for signature verification)
PAYSTACK_WEBHOOK_SECRET=your_webhook_secret_from_paystack_dashboard


# ==============================================================================
# EMAIL SERVICE (RESEND)
# ==============================================================================

# Resend API key
RESEND_API_KEY=re_your_resend_api_key_here

# From email address (must be verified domain)
RESEND_FROM_EMAIL=noreply@yourdomain.com

# From name
RESEND_FROM_NAME=EOS Tracker


# ==============================================================================
# APPLICATION SETTINGS
# ==============================================================================

# Environment (development, staging, production)
ENVIRONMENT=development

# Debug mode (True for development, False for production)
DEBUG=True

# Application URL (used for email links and redirects)
APP_URL=http://localhost:8000

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000


# ==============================================================================
# RATE LIMITING
# ==============================================================================

# Enable rate limiting
RATE_LIMIT_ENABLED=True

# Maximum requests per period
RATE_LIMIT_REQUESTS=100

# Rate limit period in seconds (3600 = 1 hour)
RATE_LIMIT_PERIOD=3600


# ==============================================================================
# SCHEDULER (APSCHEDULER)
# ==============================================================================

# Enable alert scheduler
SCHEDULER_ENABLED=True

# Alert check frequency (cron format: hour, minute)
SCHEDULER_HOUR=9
SCHEDULER_MINUTE=0


# ==============================================================================
# LOGGING
# ==============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Log file path
LOG_FILE=logs/eos_tracker.log


# ==============================================================================
# OPTIONAL: EXTERNAL SERVICES
# ==============================================================================

# Sentry DSN (for error tracking in production)
# SENTRY_DSN=https://your_sentry_dsn_here

# Redis URL (for caching and session storage)
# REDIS_URL=redis://localhost:6379/0


# ==============================================================================
# DEPLOYMENT-SPECIFIC VARIABLES
# ==============================================================================

# Railway.app automatically provides DATABASE_URL
# DigitalOcean App Platform provides ${db.DATABASE_URL}
# AWS requires manual configuration

# For managed database services, uncomment the appropriate line:
# DATABASE_URL=${DATABASE_URL}  # Railway
# DATABASE_URL=${db.DATABASE_URL}  # DigitalOcean
